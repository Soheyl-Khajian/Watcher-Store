# Everything the images do not need. The Dockerfiles copy only the lockfile,
# the package manifests and their own app's directory, so this mainly keeps
# the build context small and secrets out of it.

# Dependencies and package managers
**/node_modules
.pnpm-store
**/.pnpm-debug.log

# Build outputs and caches
**/.next
**/dist
**/build
**/.cache
**/coverage
**/*.tsbuildinfo

# Local env and secrets
**/.env
**/.env.*
!.env.example

# Payload media (local uploads)
backend/payload-cms/media

# Tests (not part of any image)
backend/nest-api/test
backend/payload-cms/tests
**/*.test.ts
**/*.spec.ts

# Repository, tooling and docs
.git
.github
.claude
.devcontainer
.vscode
.idea
assets
docs
scripts
**/*.md

# Logs and OS files
**/*.log
**/.DS_Store
