{
  "name": "payload-cms",
  "version": "1.0.0",
  "description": "",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --webpack -p 3000",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build --webpack",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "generate:migration": "payload migrate:create",
    "migrate": "payload migrate",
    "migrate:fresh": "payload migrate:fresh",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types && prettier --write src/payload-types.ts",
    "test": "cross-env NODE_OPTIONS=--no-deprecation vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "tsx src/seed.ts",
    "seed:admin": "tsx src/seed-admin.ts",
    "seed:demo": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed-demo.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.94.1",
    "@payloadcms/email-nodemailer": "^3.94.1",
    "@payloadcms/next": "3.94.1",
    "@payloadcms/richtext-slate": "^3.94.1",
    "@payloadcms/storage-s3": "3.94.1",
    "@payloadcms/translations": "^3.94.1",
    "@payloadcms/ui": "3.94.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.4.6",
    "payload": "^3.94.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "0.35.5",
    "slug": "^11.0.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/slug": "^5.0.9",
    "prettier": "3.10.1",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.3"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": "^9 || ^10"
  }
}
