{
  "name": "Store Backend DevContainer",
  "dockerComposeFile": "docker-compose.yml",
  "service": "payload",
  "workspaceFolder": "/workspace",
  "remoteUser": "node",
  "forwardPorts": [3000, 3001],
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  },
  "postCreateCommand": "npm install"
}
