//دفترچه راهنمای خود ادیتور
{
  "name": "Store DevContainer",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app", //اتاق کار اصلی
  "workspaceFolder": "/workspace", //مسیر پیش فرض ترمینال
  "remoteUser": "node",
  "forwardPorts": [3000, 3001, 3002],
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  },
  "postCreateCommand": "npm install -g pnpm && pnpm install", //فقط یکبار اجرا میشود
  "postStartCommand": "pnpm --filter payload-cms run migrate && pnpm run start:all"
}
