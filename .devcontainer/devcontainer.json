{
  "name": "Store DevContainer",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "remoteUser": "node",
  "forwardPorts": [3000, 3001, 3002],
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  },
  "postCreateCommand": "npm install -g pnpm && pnpm install", // runs only once
  "postStartCommand": "pnpm --filter payload-cms run migrate && pnpm run start:all" // runs every time the container starts
}
