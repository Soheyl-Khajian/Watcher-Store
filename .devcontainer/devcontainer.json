{
  "name": "Store DevContainer",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "remoteUser": "node",
  "forwardPorts": [3000, 3001, 3002],
  "mounts": [
    "source=watcher-pnpm-store,target=/home/node/.local/share/pnpm/store,type=volume",
    "source=watcher-vscode-server,target=/home/node/.vscode-server,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  },
  "postCreateCommand": "pnpm install --frozen-lockfile", // runs only once
  "postStartCommand": "pnpm --filter payload-cms run migrate && pnpm run start:all" // runs every time the container starts
}
