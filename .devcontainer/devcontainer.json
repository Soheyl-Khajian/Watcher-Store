{
  "name": "Watcher Store",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "remoteUser": "node",

  "forwardPorts": [3000, 3001, 3002],
  "portsAttributes": {
    "3000": { "label": "payload-cms", "onAutoForward": "silent" },
    "3001": { "label": "nest-api", "onAutoForward": "silent" },
    "3002": { "label": "frontend", "onAutoForward": "openPreview" }
  },
  "otherPortsAttributes": { "onAutoForward": "ignore" },

  // Kept across rebuilds: the pnpm store, and the editor's server and
  // extensions (otherwise downloaded again on every rebuild).
  "mounts": [
    "source=watcher-pnpm-store,target=/home/node/.local/share/pnpm/store,type=volume",
    "source=watcher-cursor-server,target=/home/node/.cursor-server,type=volume",
    "source=watcher-vscode-server,target=/home/node/.vscode-server,type=volume"
  ],

  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": { "path": "/bin/bash" }
        },
        "remote.autoForwardPorts": false
      }
    }
  },

  // The one step, on every container start (first create included): the
  // database schemas, packages, Payload's migrations, then the three apps
  // in the background. It runs in this order, inside the container only.
  // Status, logs and restarts: .devcontainer/dev.sh, or the "dev:" tasks.
  "postStartCommand": "bash .devcontainer/dev.sh boot"
}
