# Copy to ".env" in the repository root:
#   cp .env.example .env
#
# Used by Docker Compose, Payload CMS, NestJS, and the Next.js storefront.
# dotenv does NOT expand ${VAR} variables, so write DATABASE_URI literally.
# Inside the container the database hostname is "db".

# ============================================
# PostgreSQL
# ============================================
POSTGRES_USER=postgres
# Fine for local development. For any deployment use a strong password
# (openssl rand -hex 24) here and in DATABASE_URI: with NODE_ENV=production
# Payload refuses to start with a default password such as "postgres".
POSTGRES_PASSWORD=postgres
POSTGRES_DB=watcher_store

# ============================================
# Payload CMS (port 3000)
# ============================================
# Same user/password/db as above, hostname "db" (Compose service name).
# Schema is PAYLOAD_SCHEMA, not a query string on this URI.
# Required: generate with `openssl rand -hex 32`. The placeholder is too short
# on purpose, so an unedited copy of this file fails at startup.
PAYLOAD_SECRET=CHANGE_ME
PAYLOAD_SCHEMA=payload_schema
# Literal URI — dotenv does NOT expand ${VAR}.
DATABASE_URI=postgres://postgres:postgres@db:5432/watcher_store?schema=payload_schema

# Where browsers reach the CMS (admin panel and media files), as an origin.
# Payload's serverURL and the only origin trusted for its session cookie.
# With an https:// URL the session cookie is also marked Secure.
PAYLOAD_PUBLIC_URL=http://localhost:3000

# Used only by `pnpm --filter payload-cms seed:admin`, which creates this
# administrator if it does not exist (safe to re-run; never resets the
# password or promotes an existing customer). Run it on a new deployment
# instead of leaving the admin panel's first-user screen open. Password:
# at least 8 characters.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
# ADMIN_DISPLAY_NAME=Watcher Store Admin

# Server-to-Payload URL used by NestJS and frontend server rendering.
# Docker Compose overrides this with http://payload-cms:3000/api.
PAYLOAD_INTERNAL_URL=http://localhost:3000/api

# Server-to-Nest URL used by the Payload admin Orders view (server-side only,
# never exposed to the browser). Docker Compose overrides this with
# http://nest-api:3001.
NEST_INTERNAL_URL=http://localhost:3001

# ============================================
# NestJS API (port 3001)
# ============================================
PORT=3001
# Required: generate with `openssl rand -hex 32` (see PAYLOAD_SECRET).
# With NODE_ENV=production Nest also refuses placeholder secrets and an
# unset or default POSTGRES_PASSWORD.
JWT_SECRET=CHANGE_ME
# How long a storefront login stays valid, e.g. 60m, 12h, 7d.
JWT_EXPIRES_IN=60m
DATABASE_HOST=db
DATABASE_PORT=5432

# Keep this value as nest_schema. The generated initial migration hardcodes
# the schema name; changing it requires regenerating the initial migration
# and resetting the migration history.
NEST_SCHEMA=nest_schema

# Whether Nest applies pending migrations when it starts. Leave unset: on in
# development, off with NODE_ENV=production, where the nest-migrate job
# (node dist/database/migrate.js) applies them once before the API starts.
# MIGRATIONS_RUN_ON_BOOT=false

# Payment gateway: none (default; payments answer 503) or mock.
# mock is DEVELOPMENT ONLY: no money moves and the customer's reported result
# is believed, so anyone could mark an order as paid. Nest refuses to start
# with NODE_ENV=production and PAYMENT_GATEWAY=mock.
# (Replaces ALLOW_MOCK_PAYMENT: Nest refuses ALLOW_MOCK_PAYMENT=true.)
PAYMENT_GATEWAY=none

# Nest log verbosity: fatal, error, warn, info, debug, trace or silent.
# JSON lines in production, readable text in development.
LOG_LEVEL=info

# How long Nest waits for Payload before answering 503 (milliseconds).
PAYLOAD_TIMEOUT_MS=5000

# Rate limits per client IP and route, per minute. /health is never limited.
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_ORDERS_PER_MINUTE=10

# Reverse proxies allowed to report the client IP (X-Forwarded-For), so rate
# limits apply per real client. "false" when Nest is reached directly; a hop
# count such as 1 behind one proxy, or proxy addresses/subnets. Never "true".
TRUST_PROXY=false

# Unpaid (pending) orders older than this many hours are cancelled
# automatically. Integer between 1 and 720.
PENDING_ORDER_TTL_HOURS=24

# Used only by the test suites (nest-api test:e2e, payload-cms test). Any
# database on a Postgres server where this user may CREATE DATABASE; each test
# file creates and drops its own database there. Same credentials as above,
# hostname "db".
TEST_DATABASE_URL=postgres://postgres:postgres@db:5432/postgres

# ============================================
# Next.js Storefront (port 3002)
# ============================================
# These URLs are embedded into the frontend browser bundle during Docker build.
# They must be reachable from the user's browser, not only from Docker containers.
NEXT_PUBLIC_PAYLOAD_URL=http://localhost:3000/api
NEXT_PUBLIC_NESTJS_API_URL=http://localhost:3001
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3002

# FRONTEND_URL is for backend CORS/redirects. NEXT_PUBLIC_FRONTEND_URL is for the browser.
FRONTEND_URL=http://localhost:3002


# ============================================
# Dev Containers
# ============================================
# 0 = let .vscode/tasks.json own service startup (one terminal per service).
AUTOSTART_SERVERS=0

# ============================================
# Media Storage (TODO: move to S3/R2 for production)
# ============================================
# Currently Payload stores uploads in backend/payload-cms/media/
# which is ephemeral in containers. For a real demo, configure
# @payloadcms/storage-s3 or @payloadcms/storage-cloudflare-r2.