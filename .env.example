# Copy to ".env" in the repository root:
#   cp .env.example .env
#
# Used by Docker Compose (Postgres + app container), Payload CMS, NestJS,
# and the Next.js storefront. Docker Compose DOES expand ${VAR} in this file, so DATABASE_URI can be
# composed from the values above. Note that dotenv does NOT expand variables:
# if you ever run these services outside the Dev Container, write DATABASE_URI
# out literally. Inside the container the database hostname is "db".

# --- PostgreSQL (official postgres image + NestJS) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=watcher_store

# --- NestJS (commerce API, port 3001) ---
DATABASE_HOST=db
DATABASE_PORT=5432
NEST_SCHEMA=nest_schema
PORT=3001
JWT_SECRET=change-me-to-a-long-random-string

# --- Payload CMS (port 3000) ---
# Same user/password/db as above, hostname "db" (Compose service name).
# Schema is PAYLOAD_SCHEMA, not a query string on this URI.
PAYLOAD_SCHEMA=payload_schema
DATABASE_URI=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?schema=${PAYLOAD_SCHEMA}
PAYLOAD_SECRET=change-me-to-another-long-random-string

# --- Storefront (Next.js, port 3002) ---
# Browser and server-side fetch from inside the same container.
PAYLOAD_API_URL=http://localhost:3000/api
NEXT_PUBLIC_PAYLOAD_URL=http://localhost:3000

# --- Dev Containers ---
# 0 = let .vscode/tasks.json own service startup (one terminal per service).
AUTOSTART_SERVERS=0
