# Copy to ".env" in the repository root:
#   cp .env.example .env
#
# Used by Docker Compose, Payload CMS, NestJS, and the Next.js storefront.
# dotenv does NOT expand ${VAR} variables, so write DATABASE_URI literally.
# Inside the container the database hostname is "db".

# ============================================
# PostgreSQL
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=watcher_store

# ============================================
# Payload CMS (port 3000)
# ============================================
# Same user/password/db as above, hostname "db" (Compose service name).
# Schema is PAYLOAD_SCHEMA, not a query string on this URI.
# Generate secret with: openssl rand -hex 32
PAYLOAD_SECRET=replace-with-64-char-hex-secret-from-openssl-rand-hex-32
PAYLOAD_SCHEMA=payload_schema
# Literal URI — dotenv does NOT expand ${VAR}.
DATABASE_URI=postgres://postgres:postgres@db:5432/watcher_store?schema=payload_schema

# Server-to-Payload URL used by NestJS and frontend server rendering.
# Docker Compose overrides this with http://payload-cms:3000/api.
PAYLOAD_INTERNAL_URL=http://localhost:3000/api

# ============================================
# NestJS API (port 3001)
# ============================================
PORT=3001
# Generate secret with: openssl rand -hex 32
JWT_SECRET=replace-with-64-char-hex-secret-from-openssl-rand-hex-32
DATABASE_HOST=db
DATABASE_PORT=5432

# Keep this value as nest_schema. The generated initial migration hardcodes
# the schema name; changing it requires regenerating the initial migration
# and resetting the migration history.
NEST_SCHEMA=nest_schema

# ============================================
# Next.js Storefront (port 3002)
# ============================================
# These URLs are embedded into the frontend browser bundle during Docker build.
# They must be reachable from the user's browser, not only from Docker containers.
NEXT_PUBLIC_PAYLOAD_URL=http://localhost:3000/api
NEXT_PUBLIC_NESTJS_API_URL=http://localhost:3001
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3002

# FRONTEND_URL is for backend CORS/redirects. NEXT_PUBLIC_FRONTEND_URL is for the browser.
FRONTEND_URL=http://localhost:3002


# ============================================
# Dev Containers
# ============================================
# 0 = let .vscode/tasks.json own service startup (one terminal per service).
AUTOSTART_SERVERS=0

# ============================================
# Media Storage (TODO: move to S3/R2 for production)
# ============================================
# Currently Payload stores uploads in backend/payload-cms/media/
# which is ephemeral in containers. For a real demo, configure
# @payloadcms/storage-s3 or @payloadcms/storage-cloudflare-r2.