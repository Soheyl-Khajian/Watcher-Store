# Copy to ".env" in the repository root:
#   cp .env.example .env
#
# Used by Docker Compose, Payload CMS, NestJS, and the Next.js storefront.
# dotenv does NOT expand ${VAR} variables, so write DATABASE_URI literally.
# Inside the container the database hostname is "db".

# ============================================
# PostgreSQL
# ============================================
POSTGRES_USER=postgres
# Fine for local development. For any deployment use a strong password
# (openssl rand -hex 24) here and in DATABASE_URI: with NODE_ENV=production
# Payload refuses to start with a default password such as "postgres".
POSTGRES_PASSWORD=postgres
POSTGRES_DB=watcher_store

# docker-compose.prod.yml only: the passwords of the services' own database
# roles. There POSTGRES_USER is used just by the database and its setup
# jobs; Payload connects as payload_app and Nest as nest_app, each owning
# only its own schema (deploy/postgres/). Required there; generate each
# with `openssl rand -hex 24` (letters and digits only, as they go into a
# URL). Change one and redeploy to rotate it. Local development keeps using
# POSTGRES_USER.
PAYLOAD_DB_PASSWORD=
NEST_DB_PASSWORD=

# ============================================
# Payload CMS (port 3000)
# ============================================
# Same user/password/db as above, hostname "db" (Compose service name).
# Schema is PAYLOAD_SCHEMA, not a query string on this URI.
# docker-compose.prod.yml builds its own from PAYLOAD_DB_PASSWORD.
# Required: generate with `openssl rand -hex 32`. The placeholder is too short
# on purpose, so an unedited copy of this file fails at startup.
PAYLOAD_SECRET=CHANGE_ME
PAYLOAD_SCHEMA=payload_schema
# Literal URI — dotenv does NOT expand ${VAR}.
DATABASE_URI=postgres://postgres:postgres@db:5432/watcher_store?schema=payload_schema

# Where browsers reach the CMS (admin panel and media files), as an origin.
# Payload's serverURL and the only origin trusted for its session cookie.
# With an https:// URL the session cookie is also marked Secure.
PAYLOAD_PUBLIC_URL=http://localhost:3000

# Used only by `pnpm --filter payload-cms seed:admin`, which creates this
# administrator if it does not exist (safe to re-run; never resets the
# password or promotes an existing customer). Run it on a new deployment
# instead of leaving the admin panel's first-user screen open. Password:
# at least 8 characters.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
# ADMIN_DISPLAY_NAME=Watcher Store Admin

# Server-to-Payload URL used by NestJS and frontend server rendering.
# Docker Compose overrides this with http://payload-cms:3000/api.
PAYLOAD_INTERNAL_URL=http://localhost:3000/api

# Server-to-Nest URL used by the Payload admin Orders view and the
# storefront's own server (its /api routes, which hold the login session).
# Server-side only, never exposed to the browser. Docker Compose overrides
# this with http://nest-api:3001.
NEST_INTERNAL_URL=http://localhost:3001

# Content edits in Payload refresh the storefront's cache at once: Payload
# calls the storefront's /api/revalidate with this shared secret (generate
# with `openssl rand -hex 32`). Leave empty to turn it off; edits then show
# up when the cache runs out (an hour for pages and posts, a minute for
# products). STOREFRONT_INTERNAL_URL is where Payload reaches the
# storefront; Docker Compose sets it to http://frontend:3002.
REVALIDATE_SECRET=
STOREFRONT_INTERNAL_URL=http://localhost:3002

# ============================================
# NestJS API (port 3001)
# ============================================
PORT=3001
# Required: generate with `openssl rand -hex 32` (see PAYLOAD_SECRET).
# With NODE_ENV=production Nest also refuses placeholder secrets and an
# unset or default POSTGRES_PASSWORD.
JWT_SECRET=CHANGE_ME
# How long a storefront login stays valid, e.g. 60m, 12h, 7d.
JWT_EXPIRES_IN=60m
DATABASE_HOST=db
DATABASE_PORT=5432

# Keep this value as nest_schema. The generated initial migration hardcodes
# the schema name; changing it requires regenerating the initial migration
# and resetting the migration history.
NEST_SCHEMA=nest_schema

# Whether Nest applies pending migrations when it starts. Leave unset: on in
# development, off with NODE_ENV=production, where the nest-migrate job
# (node dist/database/migrate.js) applies them once before the API starts.
# MIGRATIONS_RUN_ON_BOOT=false

# Payment gateway: none (default; payments answer 503), zarinpal or mock.
# mock is DEVELOPMENT ONLY: no money moves and every return from the
# "gateway" counts as paid, so anyone could mark an order as paid. Nest
# refuses to start with NODE_ENV=production and PAYMENT_GATEWAY=mock.
# (Replaces ALLOW_MOCK_PAYMENT: Nest refuses ALLOW_MOCK_PAYMENT=true.)
PAYMENT_GATEWAY=none

# Where the gateway sends the customer's browser back after paying: Nest's
# GET /payment/callback, at a URL the browser can reach. In local
# development it defaults to http://localhost:3001/payment/callback.
# docker-compose.prod.yml keeps Nest off the public network and defaults it
# to the storefront's relay, <FRONTEND_URL>/api/payment/callback.
# PAYMENT_CALLBACK_URL=http://localhost:3001/payment/callback

# Zarinpal (PAYMENT_GATEWAY=zarinpal). The merchant id comes from the
# Zarinpal panel; on the sandbox any UUID works. Use
# https://payment.zarinpal.com for real payments.
# ZARINPAL_MERCHANT_ID=
ZARINPAL_BASE_URL=https://sandbox.zarinpal.com
# How long Nest waits for the gateway (milliseconds).
PAYMENT_TIMEOUT_MS=10000
# Pending payments older than this (minutes) are checked with the gateway:
# the customer may have paid and closed the browser before coming back.
PAYMENT_RECONCILE_AFTER_MINUTES=15

# Nest log verbosity: fatal, error, warn, info, debug, trace or silent.
# JSON lines in production, readable text in development.
LOG_LEVEL=info

# How long Nest waits for Payload before answering 503 (milliseconds).
PAYLOAD_TIMEOUT_MS=5000

# Rate limits per client IP and route, per minute. /health is never limited.
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_ORDERS_PER_MINUTE=10

# Reverse proxies allowed to report the client IP (X-Forwarded-For), so rate
# limits apply per real client. "false" when Nest is reached directly; a hop
# count such as 1 behind one proxy, or proxy addresses/subnets. Never "true".
# docker-compose.prod.yml sets 1: there Nest is reached only through the
# storefront, which reports the client (see TRUSTED_PROXY_HOPS).
TRUST_PROXY=false

# Unpaid (pending) orders older than this many hours are cancelled
# automatically. Integer between 1 and 720.
PENDING_ORDER_TTL_HOURS=24

# Used only by the test suites (nest-api test:e2e, payload-cms test). Any
# database on a Postgres server where this user may CREATE DATABASE; each test
# file creates and drops its own database there. Same credentials as above,
# hostname "db".
TEST_DATABASE_URL=postgres://postgres:postgres@db:5432/postgres

# ============================================
# Next.js Storefront (port 3002)
# ============================================
# These URLs are embedded into the frontend browser bundle during Docker build.
# They must be reachable from the user's browser, not only from Docker containers.
# The browser never calls Nest directly: the storefront's server does (see
# NEST_INTERNAL_URL), holding the login session in an httpOnly cookie.
NEXT_PUBLIC_PAYLOAD_URL=http://localhost:3000/api
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3002

# How many reverse proxies in front of the storefront add the customer's
# address to X-Forwarded-For (it is passed to Nest for per-customer rate
# limits). 0 when browsers reach the storefront directly: the header is then
# whatever the browser sent, so it is not passed on, and Nest's limits apply
# to all such customers together. 1 behind one reverse proxy (Caddy, nginx)
# that adds or sets the header.
TRUSTED_PROXY_HOPS=0

# FRONTEND_URL is for backend CORS/redirects. NEXT_PUBLIC_FRONTEND_URL is for the browser.
FRONTEND_URL=http://localhost:3002


# ============================================
# Dev Containers
# ============================================
# 0 = let .vscode/tasks.json own service startup (one terminal per service).
AUTOSTART_SERVERS=0

# ============================================
# Media storage (Payload uploads)
# ============================================
# Without S3_BUCKET, uploads are stored on local disk: backend/payload-cms/
# media/ in development, the payload-media volume in
# docker-compose.prod.yml. With it, in this S3-compatible bucket (AWS S3,
# Cloudflare R2, MinIO, ...). Either way files are served through Payload
# (/api/media/file/...) with its access rules, so the bucket can stay
# private, and the storefront shows them from its own /uploads/.
# Switching later needs no migration, but files already uploaded are not
# copied across.
S3_BUCKET=
# Required with S3_BUCKET; "auto" for Cloudflare R2.
S3_REGION=
# Only for a provider other than AWS, e.g.
# https://<account>.r2.cloudflarestorage.com or http://minio:9000.
S3_ENDPOINT=
# Both or neither (neither: the AWS SDK's own credentials, e.g. an IAM role).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO (bucket name in the path, not the host name).
S3_FORCE_PATH_STYLE=false
