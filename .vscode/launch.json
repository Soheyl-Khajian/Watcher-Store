{
  // Debug the storefront (server and browser). It needs port 3002, so stop
  // the background storefront first: "dev: stop" → frontend, or
  // bash .devcontainer/dev.sh stop frontend.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Storefront: debug full stack",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "program": "${workspaceFolder}/frontend/node_modules/next/dist/bin/next",
      "args": ["dev", "-p", "3002"],
      "runtimeArgs": ["--inspect"],
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "action": "debugWithChrome",
        "killOnServerStop": true,
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s",
        "webRoot": "${workspaceFolder}/frontend"
      }
    }
  ]
}
