{
  // Tools for the Dev Container's apps (Terminal → Run Task). None runs by
  // itself: the container starts the apps on every start
  // (.devcontainer/dev.sh boot), and these tasks only look at or restart
  // them. Each is the same as running .devcontainer/dev.sh in a terminal.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev: status",
      "type": "shell",
      "command": "bash .devcontainer/dev.sh status",
      "problemMatcher": [],
      "presentation": { "panel": "shared", "reveal": "always" }
    },
    {
      "label": "dev: logs",
      "type": "shell",
      "command": "bash .devcontainer/dev.sh logs ${input:app}",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "new", "reveal": "always" }
    },
    {
      "label": "dev: restart",
      "type": "shell",
      "command": "bash .devcontainer/dev.sh restart ${input:app}",
      "problemMatcher": [],
      "presentation": { "panel": "shared", "reveal": "always" }
    },
    {
      "label": "dev: stop",
      "type": "shell",
      "command": "bash .devcontainer/dev.sh stop ${input:app}",
      "problemMatcher": [],
      "presentation": { "panel": "shared", "reveal": "always" }
    },
    {
      "label": "dev: start",
      "type": "shell",
      "command": "bash .devcontainer/dev.sh start ${input:app}",
      "problemMatcher": [],
      "presentation": { "panel": "shared", "reveal": "always" }
    }
  ],
  "inputs": [
    {
      "id": "app",
      "type": "pickString",
      "description": "Which app?",
      "options": ["all", "payload-cms", "nest-api", "frontend"],
      "default": "all"
    }
  ]
}
