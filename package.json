{
  "name": "watcher-store",
  "private": true,
  "scripts": {
    "bootstrap": "pnpm install",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter nest-api test:e2e",
    "test:stack": "pnpm --filter e2e e2e",
    "sync:payload-types": "node scripts/sync-payload-types.mjs",
    "start:payload": "pnpm --filter payload-cms dev",
    "start:nest": "pnpm --filter nest-api start:dev",
    "start:frontend": "pnpm --filter frontend dev",
    "start:all": "pnpm exec concurrently \"pnpm start:payload\" \"pnpm start:nest\" \"pnpm start:frontend\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "concurrently": "^8.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript-eslint": "^8.70.0"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "react": "19.1.10",
      "react-dom": "19.1.10",
      "postcss@8": "^8.5.18",
      "express@4": "^4.22.3",
      "body-parser@1": "^1.20.9",
      "multer@2": "^2.5.0",
      "lodash@4": "^4.18.1",
      "esbuild@<0.28.0": "^0.28.2"
    },
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver",
      "@tailwindcss/oxide",
      "@nestjs/core"
    ]
  },
  "engines": {
    "node": ">=24 <25"
  },
  "license": "MIT"
}
