{
  "name": "watcher-store",
  "private": true,
  "scripts": {
    "bootstrap": "pnpm install",
    "start:payload": "pnpm --filter payload-cms dev",
    "start:nest": "pnpm --filter nest-api start:dev",
    "start:frontend": "pnpm --filter frontend dev",
    "start:all": "pnpm exec concurrently \"pnpm start:payload\" \"pnpm start:nest\" \"pnpm start:frontend\""
  },
  "devDependencies": {
    "concurrently": "^8.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0"
    },
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver",
      "@tailwindcss/oxide",
      "@nestjs/core"
    ]
  }
}
